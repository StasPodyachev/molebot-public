# =============================================================================
# .env.example — EVM контракты (Mantle)
# =============================================================================

# Приватный ключ деплоера (с 0x префиксом)
# ⚠️ НЕ КОММИТИТЬ! Использовать только для testnet!
DEPLOYER_PRIVATE_KEY=0x...

# Адрес агента (ElizaOS) — будет вызывать updateMood / checkLevelUp
AGENT_ADDRESS=0x...

# Placeholder URI (до reveal)
PLACEHOLDER_URI=ipfs://placeholder/

# API ключ для верификации на Mantle Explorer (опционально)
MANTLE_SCAN_API_KEY=
