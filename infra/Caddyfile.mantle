# Caddyfile — VPS (API + RPC proxy for CF Pages)

:80 {
	# CORS headers for all API responses
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization"
	}

	# Handle CORS preflight
	@cors_preflight {
		method OPTIONS
	}
	handle @cors_preflight {
		respond 204
	}

	# RPC Proxy
	handle /rpc {
		reverse_proxy https://rpc.sepolia.mantle.xyz {
			header_up Host rpc.sepolia.mantle.xyz
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# API — mantle-agent
	handle /api/* {
		reverse_proxy mantle-agent:3002 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	# LLM Gateway
	handle /v1/* {
		reverse_proxy llm-gateway:3010 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	# Healthcheck
	handle /health {
		reverse_proxy mantle-agent:3002
	}

	handle {
		respond "Not Found" 404
	}
}
