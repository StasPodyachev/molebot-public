# =============================================================================
# .env.demo — ENV переменные для demo-стека (локальный запуск)
#
# Использование:
#   cp .env.demo .env
#   docker compose -f infra/docker-compose.demo.yml up -d
#
# ⚠️ Это DEMO-файл: все секреты — плейсхолдеры.
#   Для production используй infra/.env.mantle + Infisical.
# =============================================================================

