# Backend Molebot Chat API
# Copy to .env and fill

# Контракт MolebotNFT
NFT_CONTRACT_ADDRESS=0xFA9071C5c87c5B940Bf83B030fE52f3500559aCb

# Mantle Sepolia RPC
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
CHAIN_ID=5003

# Адрес кошелька агента (куда пользователи шлют MNT)
AGENT_WALLET_ADDRESS=0x...

# Redis (опционально — для usedTxHashes)
# REDIS_URL=redis://localhost:6379

# Порт API
API_PORT=3002

# Директория для лога биллинга
CHAT_BILLING_LOG_DIR=./data

# Директория для истории чата (JSON fallback)
CHAT_HISTORY_DIR=./data/chat-history
