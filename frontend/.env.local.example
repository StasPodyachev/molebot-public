# Frontend — Cloudflare Pages (static export)
# Copy to .env.local for local dev

# Privy App ID (из Privy Dashboard)
NEXT_PUBLIC_PRIVY_APP_ID=

# Адрес контракта MolebotNFT (для фронта)
NEXT_PUBLIC_NFT_CONTRACT=0xFA9071C5c87c5B940Bf83B030fE52f3500559aCb

# Chain ID
NEXT_PUBLIC_CHAIN_ID=5003

# API URL (только для локальной разработки; на CF Pages /api проксируется через _redirects)
# NEXT_PUBLIC_API_URL=http://localhost:3002

# Пропустить MNT-перевод при отправке сообщений в чат (dev-режим)
# VITE_CHAT_SKIP_PAYMENT=true
