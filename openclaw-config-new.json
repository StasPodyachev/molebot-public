        "instructionsFile": "coder.md",
        "sandbox": { "mode": "off", "scope": "agent", "workspaceAccess": "rw" },
        "model": "deepseek-v4-pro",
        "tools": {
          "allow": ["fs.read", "fs.write", "git.read", "git.branch", "git.commit", "git.push", "shell.run"],
          "deny": ["git.merge", "deploy.run"]
