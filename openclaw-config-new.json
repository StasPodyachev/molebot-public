          "deny": ["fs.write", "git.push", "git.merge", "deploy.run"]
        }
      },
      {
        "id": "deployer",
        "title": "Deployer",
        "workspace": "/home/x/.openclaw/workspace/deployer",
        "agentDir": "/home/x/molebot_mantle/agents",
        "instructionsFile": "deployer.md",
        "sandbox": { "mode": "off", "scope": "agent", "workspaceAccess": "rw" },
        "model": "deepseek-v4-flash",
        "tools": {
          "allow": ["fs.read", "git.read", "shell.run", "deploy.run"],
          "deny": ["fs.write", "git.push", "git.merge"]
        }
      }
