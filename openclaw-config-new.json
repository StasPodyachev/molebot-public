  "channels": {
    "telegram": {
      "accounts": {
        "planner": {
          "botTokenRef": "infisical://molebot-platform/Development/TG_TOKEN_PLANNER",
          "botUsername": "ocstas_bot",
          "groupPolicy": "owner-only"
        },
        "coder": {
          "botTokenRef": "infisical://molebot-platform/Development/TG_TOKEN_CODER",
          "botUsername": "OC_razrab_bot",
          "groupPolicy": "owner-only"
        },
        "reviewer": {
          "botTokenRef": "infisical://molebot-platform/Development/TG_TOKEN_REVIEWER",
          "botUsername": "OC_TESTER1_bot",
          "groupPolicy": "owner-only"
        },
        "deployer": {
          "botTokenRef": "infisical://molebot-platform/Development/TG_TOKEN_OC_DEPLOYER_BOT",
          "botUsername": "OC_deployer_bot",
          "groupPolicy": "owner-only"
        }
      }
    }
  },

  "bindings": [
    { "account": "planner",  "agent": "planner"  },
    { "account": "coder",    "agent": "coder"    },
    { "account": "reviewer", "agent": "reviewer" },
    { "account": "deployer", "agent": "deployer" }
  ],

  "routing": {
    "fallbackAgent": "planner",
    "ambiguous": "reject"
  },

  "tools": {
    "agentToAgent": { "enabled": false },
    "sessions": { "visibility": "self" },
    "deploy": {
      "requireConfirmation": true,
      "confirmChannel": "deployer"
    }
  },

  "notifications": {
    "channel": "deployer",
    "events": ["deploy.requested", "deploy.done", "deploy.failed", "error.critical", "status.requested"]
  }
