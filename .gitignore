# Molebot — .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
frontend/dist/
frontend/out/

# Environment files with secrets
.env
.env.local
.env.mantle
*.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Tests
coverage/
.nyc_output/

# NFT generation artifacts
nft-collection/output/

# Agent data
agent/data/*.log

# Secret & key files
scripts/testnet-key.hex
*.pem
*.key

# Hardhat / Foundry / Anvil
cache/
artifacts/
typechain-types/

# Next.js
.next/

# Ruff / Python
__pycache__/
*.pyc

# Temp
tmp/
temp/
